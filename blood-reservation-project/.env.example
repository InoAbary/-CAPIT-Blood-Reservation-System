MONGODB_LINK=mongodb://127.0.0.1:27017/blood-reservation
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173

BADGR_API=
BADGR_EMAIL=
BADGR_PASSWORD=
EMAIL_ID=
EMAIL_PASSWORD=
VITE_GMAPS_API_KEY=

# Server-only donation notifications. Never use a VITE_ prefix for secrets.
DONATION_REMINDERS_ENABLED=true
DONATION_SMS_REMINDERS_ENABLED=false
# Email uses EMAIL_ID and EMAIL_PASSWORD above (Gmail address and app password).
DONATION_EMAIL_REMINDERS_ENABLED=true
SEMAPHORE_API_KEY= #SMS WIP
SEMAPHORE_SENDER_NAME= #SMS WIP
DONATION_REMINDER_INTERVAL_MINUTES=1 #TODO: change to longer interval for production
# Required when enabled: use waiting periods approved by the participating facility.
DONATION_WAIT_WHOLE_BLOOD_DAYS=90
DONATION_WAIT_POWER_RED_DAYS=90
DONATION_WAIT_PLATELET_DAYS=90
DONATION_WAIT_PLASMA_DAYS=90
